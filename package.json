{
  "name": "computer-use-capability-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "A typed runtime for discovering and deterministically replaying computer-use capabilities.",
  "type": "module",
  "scripts": {
    "demo": "tsx demo/legacy-bank/server.ts",
    "discover": "tsx src/cli/discover.ts",
    "replay": "tsx src/cli/replay.ts",
    "curate:evidence": "tsx src/cli/curate-evidence.ts",
